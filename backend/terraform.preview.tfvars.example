aws_region   = "ap-northeast-1"
project_name = "wmfjapan"
environment  = "preview"

# Email — must be verified in AWS SES
ses_from_email                      = "admin@example.com"
admin_email                         = "admin@example.com"
admin_email_additional              = ""

# The GitHub Actions OIDC provider and deployment role are account-wide. This is
# the bootstrap state; keep both true here and false in terraform.production.tfvars.
# FIXME: Not implemented
create_github_actions_oidc_provider = true
create_github_actions_deploy_role   = true

# Cognito admin user (created post-deploy via CLI — see README)
cognito_admin_email = "admin@example.com"

# Event details (appear in confirmation emails)
event_name  = "Example Event"
event_date  = "TBD"
event_venue = "TBD"

# CORS — use preview frontend URL once created
allowed_origins = "*"

# Optional tuning
lambda_timeout        = 30
lambda_memory         = 256
log_retention_days    = 14
dynamodb_billing_mode = "PAY_PER_REQUEST"

# Frontend SPA Configuration
frontend_domain          = "preview-wmfevents.cloudnadi.com"
route53_zone_id          = "REPLACE_ME"
acm_certificate_arn      = ""
enable_s3_frontend       = true
enable_domain_management = true

# PayPay
paypay_api_key     = "REPLACE_ME"
paypay_api_secret  = "REPLACE_ME"
paypay_merchant_id = "REPLACE_ME"
paypay_env         = "sandbox"

# Square
square_application_id   = "REPLACE_ME"
square_access_token     = "REPLACE_ME"
square_location_id      = "REPLACE_ME"
square_env              = "sandbox"

# Seat Selection
square_seat_selection_webhook_signature_key  = ""
square_seat_selection_webhook_url            = ""

# Seat Upgrade
square_seat_upgrade_webhook_signature_key  = "REPLACE_ME"
square_seat_upgrade_webhook_url            = "REPLACE_ME"

# Celebrity Dinner
square_celebrity_dinner_webhook_signature_key   = "REPLACE_ME"
square_celebrity_dinner_webhook_url             = "REPLACE_ME"

# NPO Payment
square_npo_webhook_signature_key    = "REPLACE_ME"
square_npo_webhook_url              = "REPLACE_ME"

# Events Platform
square_events_webhook_signature_key = "REPLACE_ME"
square_events_webhook_url           = "REPLACE_ME"

# Attendee accounts (Cognito) — see docs/WMF_EVENTS_SITE.md
attendee_cognito_domain_prefix = "REPLACE_ME-unique-preview-prefix"
attendee_extra_origins         = ["http://localhost:5173"] # local development against the preview stack
# attendee_social_providers = {
#   Google = { provider_type = "Google", client_id = "REPLACE_ME.apps.googleusercontent.com" }
# }
# attendee_social_provider_secrets = { Google = "REPLACE_ME" }
