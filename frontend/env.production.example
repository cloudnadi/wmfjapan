# Production environment variables.
# Copy to .env.production and set values from production Terraform outputs.

# Cognito Configuration (production stack)
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=ap-northeast-1

# API Configuration (production stage)
VITE_API_BASE_URL=https://xxxxxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/prod

# Event type mapping (keep consistent with production backend expectations)
VITE_EVENT_TYPE_ONAM=onam_2026

# Use real backend integration in production
VITE_ONAM_MOCK=false
