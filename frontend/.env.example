# WMF Japan events site — frontend build-time configuration (copy to .env.local for development).
# Everything here is PUBLIC (it ends up in the browser bundle). Never put a secret in a VITE_* variable.

# ── Event platform API ───────────────────────────────────────────────────────
# Base URL of the API Gateway stage that serves /public/* (no trailing slash).
VITE_API_BASE_URL=https://REPLACE_ME.execute-api.ap-northeast-1.amazonaws.com/prod

# ── Site / branding ──────────────────────────────────────────────────────────
VITE_SITE_URL=https://wmfevents.cloudnadi.com
VITE_SITE_NAME=WMF Japan
VITE_SITE_TITLE=WMF Japan Events
VITE_ORG_NAME=WMF Japan
VITE_ORG_URL=https://www.wmfjapan.org/
# Confirm the contact address with WMF Japan. Empty = contact links are hidden.
VITE_CONTACT_EMAIL=
# Official logo for the header (https URL or /path). Empty = text wordmark. No official logo is bundled.
VITE_LOGO_URL=
# VITE_DEFAULT_LOCALE=en

# ── Attendee sign-in (Amazon Cognito, separate from the admin pool) ─────────
# Values come from the Terraform outputs attendee_user_pool_id / attendee_app_client_id / attendee_hosted_ui_domain.
VITE_AUTH_REGION=ap-northeast-1
VITE_AUTH_USER_POOL_ID=ap-northeast-1_REPLACE_ME
VITE_AUTH_CLIENT_ID=REPLACE_ME
# Hosted UI domain WITHOUT https:// (needed for social sign-in), e.g. my-prefix.auth.ap-northeast-1.amazoncognito.com
VITE_AUTH_COGNITO_DOMAIN=
# Comma-separated Cognito identity-provider names to offer, e.g. Google,Facebook. Empty = e-mail sign-in only.
VITE_AUTH_SOCIAL_PROVIDERS=
# VITE_AUTH_SCOPES=openid,email,profile
# The callback ( <origin>/auth/callback ) and sign-out ( <origin>/ ) URLs must be registered on the app client.

# ── Admin dashboard sign-in (existing admin pool; not used by attendees) ─────
VITE_COGNITO_REGION=ap-northeast-1
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_REPLACE_ME
VITE_COGNITO_CLIENT_ID=REPLACE_ME
