# Preview environment variables.
# Copy to .env.preview and set values from preview Terraform outputs.

# Cognito Configuration (preview stack)
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=ap-northeast-1

# API Configuration (preview stage)
VITE_API_BASE_URL=https://xxxxxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/preview

# Site
VITE_SITE_URL=https://preview-wmfevents.cloudnadi.com

# Attendee sign-in (Terraform outputs attendee_user_pool_id / attendee_app_client_id / attendee_hosted_ui_domain / attendee_social_providers)
VITE_AUTH_REGION=ap-northeast-1
VITE_AUTH_USER_POOL_ID=ap-northeast-1_xxxxxxxxxxxxx
VITE_AUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AUTH_COGNITO_DOMAIN=your-prefix.auth.ap-northeast-1.amazoncognito.com
VITE_AUTH_SOCIAL_PROVIDERS=
